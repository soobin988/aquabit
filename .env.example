# 이 파일을 .env로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env는 git에 올라가지 않습니다. 비밀번호는 .env에만 적으세요.

# 앱이 열릴 주소와 포트 (Apache가 같은 서버에서 프록시하므로 127.0.0.1 권장)
HOST=127.0.0.1
PORT=3001

# "게임 시작" 버튼이 연결될 게임 서비스 주소
GAME_URL=/community/login.html

# 수업 외 내용: 통합 게임의 계정·팀·과제·상점은 MySQL에 저장합니다.
# 노트북에서 DB 없이 개발할 때는 false로 두고 로그인 화면의 체험하기를 사용하세요.
GAME_DATABASE_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aquabit
DB_USER=aquabit
DB_PASSWORD=
SESSION_SECRET=

# 사내 메일 서버(hMailServer) SMTP 설정
# 실습용 서버라 25번 포트, 암호화 없이 AUTH LOGIN으로 로그인합니다.
SMTP_HOST=mail.aquabit.lab
SMTP_PORT=25
SMTP_USER=noreply@aquabit.lab
SMTP_PASS=
# 보내는 사람 주소 (비우면 SMTP_USER 사용)
MAIL_FROM=noreply@aquabit.lab
# 문의 메일을 받을 주소
MAIL_TO=support@aquabit.lab

# 수업 외 내용: 웹 사내 메일 수신·발송. 각 사용자는 웹에서 자신의 계정으로 로그인합니다.
WEBMAIL_HOST=
WEBMAIL_SERVER_NAME=mail.aquabit.lab
WEBMAIL_DOMAIN=
WEBMAIL_SMTP_PORT=25
WEBMAIL_POP_PORT=110
WEBMAIL_SMTP_SECURE=false
WEBMAIL_POP_SECURE=false
WEBMAIL_STARTTLS=false
