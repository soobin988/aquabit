<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const steps = [
    {
      icon: 'users', tone: 'coral', title: '팀 어항 만들기',
      text: '팀장이 어항 이름을 정하면 우리 팀만의 어항이 생깁니다.',
      points: ['어항 하나에 팀원 여러 명이 함께 지내요', '어항 이름은 나중에 바꿀 수 있어요'],
    },
    {
      icon: 'key', tone: 'yellow', title: '초대 코드로 팀원 참여',
      text: '어항이 만들어지면 초대 코드가 발급됩니다. 팀원에게 코드를 알려 주세요.',
      points: ['코드를 입력하면 바로 같은 어항에 들어와요', '코드가 새어 나가면 새 코드로 바꿀 수 있어요'],
    },
    {
      icon: 'palette', tone: 'violet', title: '물고기 꾸미기',
      text: '어항에 들어온 팀원은 각자 자기 물고기를 갖게 됩니다.',
      points: ['물고기 종류 고르기', '몸 색깔 바꾸기', '모자·왕관·리본·안경 같은 장신구 달기'],
    },
    {
      icon: 'grow', tone: 'mint', title: '먹이 주고 키우기',
      text: '먹이를 줄 때마다 물고기가 조금씩 자랍니다. 꾸준히 들러 챙겨 주세요.',
      points: ['먹이를 먹으면 성장치가 올라가요', '한꺼번에 많이 주기보다 자주 챙기는 게 좋아요'],
    },
    {
      icon: 'chat', tone: 'aqua', title: '어항 채팅과 말풍선',
      text: '어항마다 채팅방이 있습니다. 내가 쓴 말은 내 물고기 위에 말풍선으로 떠올라요.',
      points: ['채팅은 몇 초 간격으로 새 메시지를 불러와요 (실시간 방식은 아니에요)', '말풍선은 잠시 보였다가 사라져요'],
    },
  ];
%>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">GAME</p>
      <h1 class="page-title">Pixel Aquarium</h1>
      <p class="page-lead">팀 프로젝트 팀을 위한 픽셀 아트 아쿠아리움 커뮤니티</p>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <h2 id="steps-title" class="section-title">이렇게 즐겨요</h2>
        <p class="section-desc">어항을 만들고 팀원과 함께 지내기까지, 다섯 단계면 충분합니다.</p>
      </div>

      <ol class="steps">
        <% steps.forEach((s, i) => { %>
          <li class="step">
            <div class="step-visual tone-<%= s.tone %>" aria-hidden="true">
              <span class="step-num">STEP <%= i + 1 %></span>
              <svg class="icon step-icon"><use href="/img/icons.svg#<%= s.icon %>"/></svg>
            </div>
            <div class="step-body pixel-box">
              <h3><span class="step-num-inline">STEP <%= i + 1 %>.</span> <%= s.title %></h3>
              <p><%= s.text %></p>
              <ul class="check-list">
                <% s.points.forEach((p) => { %><li><%= p %></li><% }) %>
              </ul>
            </div>
          </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <section class="section cta" aria-labelledby="cta-title">
    <div class="container cta-inner pixel-box">
      <div>
        <h2 id="cta-title" class="cta-title">준비됐나요?</h2>
        <p>팀 어항을 만들고 첫 물고기를 띄워 보세요.</p>
      </div>
      <a class="btn btn-play" href="<%= gameUrl %>">
        게임 시작
        <svg class="icon" aria-hidden="true"><use href="/img/icons.svg#arrow"/></svg>
      </a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
